{
  "name": "mintpoint-dapp",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run --prefix frontend build",
    "build:backend": "npm run --prefix backend build",
    "dev:frontend": "npm run --prefix frontend dev",
    "start:backend": "npm run --prefix backend start",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm run --prefix frontend lint",
    "lint:backend": "npm run --prefix backend lint",
    "test": "npm run --prefix backend test",
    "prepare": "husky install"
  }
}
